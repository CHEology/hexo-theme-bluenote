<%
const home = is_home();
const pageTitle = page_title(page);
const title = pageTitle ? [pageTitle, config.title].join(' - ') : config.title;
let description = page.description || page.excerpt || (is_post() && page.content) || config.description;
if (description) description = strip_html(description).substring(0, 200).trim().replace(/\n/g, ' ');
let keywords = page.keywords || config.keywords;
if (Array.isArray(keywords)) keywords = keywords.join(',');
const ogImage = page.og_img || page.cover || page.index_img;
const cover = home && theme.home.cover ? url_for(theme.home.cover) : '';
const portrait = theme.home.cover_portrait || {};
const portraitWidths = home && portrait.base && Array.isArray(portrait.widths) ? portrait.widths : [];
/* Keep these two media queries complementary: portrait phones preload only their crop. */
const portraitMedia = '(max-width: 767px) and (orientation: portrait)';
-%>
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, shrink-to-fit=no">
<%# The viewport is declared first so phones evaluate the preload media queries at their real width. -%>
<% if (cover && theme.home.preload_cover) { -%>
<% if (portraitWidths.length) { -%>
<link rel="preload" as="image" fetchpriority="high" href="<%- cover %>" media="(min-width: 768px), (orientation: landscape)">
<link rel="preload" as="image" fetchpriority="high" type="image/webp" media="<%- portraitMedia %>" imagesrcset="<%- portraitWidths.map(w => url_for(portrait.base + '-' + w + '.webp') + ' ' + w + 'w').join(', ') %>" imagesizes="100vw">
<% } else { -%>
<link rel="preload" as="image" fetchpriority="high" href="<%- cover %>">
<% } -%>
<% } -%>
<% if (theme.favicon) { -%>
<link rel="icon" href="<%= url_for(theme.favicon) %>">
<% } -%>
<% if (theme.apple_touch_icon) { -%>
<link rel="apple-touch-icon" sizes="180x180" href="<%= url_for(theme.apple_touch_icon) %>">
<% } -%>
<% if (theme.force_https) { -%>
<meta http-equiv="Content-Security-Policy" content="upgrade-insecure-requests">
<% } -%>
<meta name="theme-color" content="<%= theme_color(page) %>">
<meta name="author" content="<%= page.author || config.author %>">
<% if (keywords) { -%>
<meta name="keywords" content="<%= keywords %>">
<% } -%>
<% if (theme.open_graph && theme.open_graph.enable) { -%>
<%- open_graph({ twitter_card: theme.open_graph.twitter_card || 'summary', image: ogImage ? url_for(ogImage) : undefined, description: description }) %>
<% } else { -%>
<meta name="description" content="<%= description %>">
<% } -%>
<title><%= title %></title>
<style id="bluenote-tokens"><%- theme_tokens_css() %></style>
<link rel="stylesheet" href="<%= url_for('/css/bluenote.css') %>">
<% (theme.custom_css || []).forEach((href) => { -%>
<link rel="stylesheet" href="<%= url_for(href) %>">
<% }); -%>
<% (theme.custom_css_deferred || []).forEach((href) => { -%>
<link rel="stylesheet" href="<%= url_for(href) %>" media="print" onload="this.media='all'">
<noscript><link rel="stylesheet" href="<%= url_for(href) %>"></noscript>
<% }); -%>
<script id="bluenote-scheme-boot"><%- scheme_boot_script() %></script>
<% if (home && theme.design !== 'letterbox' && theme.home.desktop_style === "fog") { -%>
<link rel="stylesheet" href="<%= url_for("/fonts/serif.css") %>" media="(min-width:768px)">
<noscript><style>@media(min-width:768px){html[data-home-style="fog"] .home-cover{position:absolute}}</style></noscript>
<% } -%>
<% if (theme.design === 'letterbox') { -%>
<script id="bluenote-layout-boot">
/* Resolve the permanent scrollbar before WebKit evaluates width breakpoints. Without
   this pre-paint pass, the first hover can change a bar's height at the tablet boundary. */
document.documentElement.getBoundingClientRect();
document.documentElement.setAttribute('data-layout-ready', '');
</script>
<% } -%>
</head>
